OPENAI_API_KEY=
OPERATOR_MODEL=
# Set an accessible model supporting Responses, web_search and strict JSON schema.
PORT=4180

# M3: server-side key with organization search, people search and bulk enrichment access.
APOLLO_API_KEY=
# Confirm per-page and per-person ceilings against your account. No phone/waterfall.
APOLLO_ORGANIZATION_CREDIT_CEILING=1
APOLLO_ENRICHMENT_CREDIT_CEILING=1

# Optional supervised email pilot. Google OAuth Web application client.
# Keep the actual values only in .env; never paste tokens into business context.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
